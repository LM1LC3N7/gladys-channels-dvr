{
  "name": "gladys-channels-dvr",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for Channels DVR: the recordings and disk of Channels DVR Server, and the Channels apps (play, pause, stop, mute, channel), on the local network. Unofficial, not affiliated with Fancy Bits.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-channels-dvr.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
